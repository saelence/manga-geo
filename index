<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manga Geo | მანგა ქართულად</title>
    <style>
        :root {
            --bg-color: #121214;
            --card-bg: #1e1e24;
            --text-color: #ffffff;
            --text-secondary: #a0a0ab;
            --accent-color: #ff6b81;
            --border-color: #2a2a35;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            padding-bottom: 40px;
        }

        header {
            padding: 20px 16px 12px;
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 20px;
            font-weight: 700;
            color: var(--accent-color);
            letter-spacing: 0.5px;
        }

        .logo span {
            color: var(--text-color);
        }

        .container {
            padding: 16px;
            max-width: 600px;
            margin: 0 auto;
        }

        .section-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 12px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .manga-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .manga-card {
            background-color: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            cursor: pointer;
            transition: transform 0.2s;
        }

        .manga-card:active {
            transform: scale(0.97);
        }

        .manga-cover {
            width: 100%;
            height: 200px;
            background-color: #2c2c38;
            object-fit: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            font-size: 14px;
        }

        .manga-info {
            padding: 10px;
        }

        .manga-title {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .manga-genre {
            font-size: 12px;
            color: var(--accent-color);
        }

        /* Страница читалки (скрыта по умолчанию) */
        #reader-view {
            display: none;
            padding: 10px;
        }

        .reader-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
            background: var(--card-bg);
            padding: 10px 15px;
            border-radius: 8px;
        }

        .back-btn {
            background: none;
            border: none;
            color: var(--accent-color);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
        }

        .reader-pages {
            display: flex;
            flex-direction: column;
            gap: 8px;
            align-items: center;
        }

        .reader-pages img {
            width: 100%;
            max-width: 100%;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">MANGA<span>GEO</span></div>
        <div style="font-size: 12px; color: var(--text-secondary);">მანგა ქართულად</div>
    </header>

    <div class="container" id="catalog-view">
        <div class="section-title">პოპულარული / პრემიერა</div>
        
        <div class="manga-grid">
            <!-- Карточка манги 1 -->
            <div class="manga-card" onclick="openReader('ჩემი პირველი მანგა', ['https://via.placeholder.com/600x900/1e1e24/ff6b81?text=Page+1', 'https://via.placeholder.com/600x900/1e1e24/ff6b81?text=Page+2'])">
                <div class="manga-cover">📚 Обложка</div>
                <div class="manga-info">
                    <div class="manga-title">ჩემი პირველი მანგა</div>
                    <div class="manga-genre">რომანტიკა, სკოლა</div>
                </div>
            </div>

            <!-- Карточка манги 2 (пример) -->
            <div class="manga-card" onclick="openReader('სიყვარულის ისტორია', ['https://via.placeholder.com/600x900/1e1e24/ff6b81?text=Page+1'])">
                <div class="manga-cover">🌸 Обложка</div>
                <div class="manga-info">
                    <div class="manga-title">სიყვარულის ისტორია</div>
                    <div class="manga-genre">დრამა, რომანტიკა</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Читалка -->
    <div class="container" id="reader-view">
        <div class="reader-header">
            <button class="back-btn" onclick="closeReader()">← უკან კატალოგში</button>
            <span id="current-manga-title" style="font-size: 14px; font-weight: 600;">Глава</span>
        </div>
        <div class="reader-pages" id="pages-container">
            <!-- Сюда динамически загружаются страницы манги -->
        </div>
    </div>

    <script>
        function openReader(title, pages) {
            document.getElementById('catalog-view').style.display = 'none';
            document.getElementById('reader-view').style.display = 'block';
            document.getElementById('current-manga-title').innerText = title;

            const container = document.getElementById('pages-container');
            container.innerHTML = '';

            pages.forEach(src => {
                const img = document.createElement('img');
                img.src = src;
                container.appendChild(img);
            });

            window.scrollTo(0, 0);
        }

        function closeReader() {
            document.getElementById('reader-view').style.display = 'none';
            document.getElementById('catalog-view').style.display = 'block';
        }
    </script>
</body>
</html>
